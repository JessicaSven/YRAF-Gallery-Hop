  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Welcome to the YRAF Gallery-Hop Game!\n\nCaw-caw! You\u2019ve just entered
    a digital scavenger hunt celebrating Dawson City\u2019s one-night-only Gallery
    Hop\u2014a vibrant evening of art, discovery, and community spirit. This game
    is your feathered guide to exploring exhibitions across town, collecting stamps,
    and unlocking surprises along the way.\n\nHere\u2019s how it works:\nVisit any
    participating Gallery Hop location and scan the QR code you find there. Each
    successful scan earns you a digital stamp, which appears in your collection instantly.
    You can check your progress anytime and explore locations in any order\u2014wander
    freely, just like a raven might!\n\nAt any point in the game, you can vote for
    your favourite exhibition by tapping VOTE in the Art Gallery list. One pick per
    player\u2014make it count!\n\nCollect all the available stamps to unlock:\n1.
    A chance to enter the festival prize draw\n2. A secret bonus exhibition, viewable
    only to players who complete the journey!\n\nThis mobile-friendly game requires
    no downloads or logins. Just your curiosity, your phone, and a few caw-some nudges
    from your trickster raven guide.\n\nReady to flap into action? Let the hunt begin!"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 5c3a0f1b3680e2c4c88021d17d85e47c, type: 2}
  m_sharedMaterial: {fileID: -6472340651508199185, guid: 5c3a0f1b3680e2c4c88021d17d85e47c, type: 2}
